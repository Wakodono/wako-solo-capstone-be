PORT=3001

# CORS: origins allowed to call this API
FE_LOCAL_URL=http://localhost:3000
REACT_APP_FE_PROD_URL=https://coinview-react.netlify.app

# Crypto proxy (required for /crypto routes)
RAPIDAPI_KEY=
RAPIDAPI_CRYPTO_HOST=coinranking1.p.rapidapi.com

# User accounts (optional: only the /register, /login, /me and /users routes need these)
MONGODB_URI=
JWT_SECRET=
